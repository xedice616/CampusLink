# Spring Boot reads environment variables, not this file automatically.
# Set these in the backend terminal. Never use VITE_ for secrets.
AI_PROVIDER=openai
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT=60s
CV_MAX_FILE_BYTES=5242880
CV_MAX_FILE_SIZE=5MB
CV_RETENTION_DAYS=30
# PostgreSQL deployment, optional:
# SPRING_PROFILES_ACTIVE=postgres
# DB_URL=jdbc:postgresql://localhost:5432/campuslink
# DB_USER=campuslink
# DB_PASSWORD=
